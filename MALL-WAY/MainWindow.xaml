<Window x:Class="MallWay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MallWay"
        Title="{local:Translate Path=MallName}" Width="1360" Height="820" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" FontFamily="Malgun Gothic"
        Background="{DynamicResource ColorF6F5F1}" Foreground="{DynamicResource Color262823}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseDetailCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <Style TargetType="ScrollViewer">
            <Setter Property="PanningMode" Value="VerticalOnly" />
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="DecreasePage" Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource ColorC7C6BC}" CornerRadius="2" Margin="3,0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="IncreasePage" Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="DecreasePage" Property="Command" Value="ScrollBar.PageLeftCommand" />
                                <Setter TargetName="IncreasePage" Property="Command" Value="ScrollBar.PageRightCommand" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical"><Setter Property="Width" Value="18" /></Trigger>
                <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="18" /></Trigger>
            </Style.Triggers>
        </Style>
        <ItemsPanelTemplate x:Key="MapPanel"><Canvas /></ItemsPanelTemplate>
        <Style x:Key="MapPosition" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinHeight" Value="{DynamicResource ButtonHeight}" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="{DynamicResource Font14}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Color262823}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorD5D4CB}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Color967343}" /><Setter TargetName="Surface" Property="BorderThickness" Value="3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResultButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,17" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ColorEDE6D6}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ColorAA8651}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FacilityButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,17" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="PlaceButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource ColorE6E3D9}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ColorCCC8BB}" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FontSize" Value="{DynamicResource Font17}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ColorE9D9B4}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Color8C6D3C}" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FloorTab" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="{DynamicResource Font18}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Color262823}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CategoryItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Color262823}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Surface" Background="{DynamicResource ColorWhite}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ColorF0EDE4}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ColorEDE6D6}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CategorySelect" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Color262823}" />
            <Setter Property="MinHeight" Value="{DynamicResource ButtonHeight}" />
            <Setter Property="FontSize" Value="{DynamicResource Font14}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource CategoryItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource ColorWhite}" BorderBrush="{DynamicResource ColorD5D4CB}" BorderThickness="0,0,0,1">
                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Color73766B}" StrokeThickness="1"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="10,0,32,0"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center" IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                                <Border Background="{DynamicResource ColorWhite}" BorderBrush="{DynamicResource ColorD5D4CB}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="280"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource ColorWhite}" BorderBrush="{DynamicResource ColorD8D6CC}" BorderThickness="0,0,0,1" Padding="28,12">
            <DockPanel LastChildFill="True" VerticalAlignment="Center"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{Binding LanguageButtonLabel}" Command="{Binding ToggleLanguageCommand}" Style="{StaticResource ActionButton}" Margin="0,0,10,0"/><Button Content="{Binding VisionButtonLabel}" Command="{Binding ToggleLowVisionCommand}" Style="{StaticResource ActionButton}"/></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="24" Height="25" Margin="0,0,13,0">
                    <Path Data="M 1 24 L 1 7 L 8 7 L 8 24 M 8 24 L 8 1 L 16 1 L 16 24 M 16 24 L 16 10 L 23 10 L 23 24"
                          Stroke="{DynamicResource Color9D7A46}" StrokeThickness="1.5" />
                </Grid>
                <TextBlock Text="{local:Translate Path=MallName}" FontSize="{DynamicResource Font21}" FontWeight="SemiBold" />
            </StackPanel></DockPanel>
        </Border>

        <Grid Grid.Row="1" IsEnabled="{Binding IsMapEnabled}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource LeftPanelWidth}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{DynamicResource RightPanelWidth}" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource ColorWhite}" BorderBrush="{DynamicResource ColorD8D6CC}" BorderThickness="0,0,1,0" Padding="22,24,22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Border Background="{DynamicResource ColorF5F4EF}" BorderBrush="{DynamicResource ColorBEBEB2}" BorderThickness="0,0,0,1" MinHeight="60">
                            <Grid>
                                <Path Data="M 14 9 A 5 5 0 1 1 4 9 A 5 5 0 1 1 14 9 M 13 13 L 18 18"
                                      Stroke="{DynamicResource Color55594F}" StrokeThickness="1.5" Width="22" Height="22"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                <TextBox x:Name="SearchInput" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Foreground="{DynamicResource Color262823}" CaretBrush="{DynamicResource Color262823}"
                                         Background="Transparent" BorderThickness="0" FontSize="{DynamicResource Font15}"
                                         Margin="38,0,8,0" VerticalContentAlignment="Center"
                                         AutomationProperties.Name="{DynamicResource 매장 검색}" />
                                <TextBlock Text="{DynamicResource 매장 검색}" Foreground="{DynamicResource Color777B70}" FontSize="{DynamicResource Font15}"
                                           Margin="40,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                  Style="{StaticResource CategorySelect}" Margin="0,12,0,0"
                                  AutomationProperties.Name="{DynamicResource 카테고리 선택}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{local:Translate}" TextWrapping="Wrap"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,16,0,4">
                        <TextBlock Text="{Binding ResultsSummary}" Foreground="{DynamicResource Color777B70}" FontSize="{DynamicResource Font12}" VerticalAlignment="Center" />
                        <Button Content="{DynamicResource 초기화}" Command="{Binding ResetSearchCommand}" HorizontalAlignment="Right"
                                Style="{StaticResource ActionButton}" BorderThickness="0" Padding="10,6"
                                Foreground="{DynamicResource Color777B70}" FontSize="{DynamicResource Font12}" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ResultButton}"
                                                Command="{Binding DataContext.SelectPlaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{local:Translate Path=Name}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{local:Translate Path=Name}" FontSize="{DynamicResource Font15}" TextWrapping="Wrap" Margin="0,0,6,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Floor, StringFormat={}{0}F}"
                                                           Foreground="{DynamicResource Color777B70}" FontFamily="Segoe UI" FontSize="{DynamicResource Font13}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{DynamicResource 검색 결과 없음}" Foreground="{DynamicResource Color777B70}" FontSize="{DynamicResource Font14}" Margin="10,20,0,0"
                                   Visibility="{Binding HasNoResults, Converter={StaticResource VisibleWhenTrue}}" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="28,20,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding CurrentFloor, StringFormat={}{0}F}" FontFamily="Segoe UI"
                                   FontSize="{DynamicResource Font58}" FontWeight="Light" LineHeight="64" />
                        <TextBlock Text="{local:Translate Path=Map.Name}" FontSize="{DynamicResource Font19}" Margin="14,0,0,11" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Floors}" SelectedValuePath="Number"
                             SelectedValue="{Binding CurrentFloor, Mode=OneWay}"
                             BorderThickness="0" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Number}" ContentStringFormat="{}{0}F" Style="{StaticResource FloorTab}"
                                        Command="{Binding DataContext.ChangeFloorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both" CanContentScroll="False"><Viewbox Stretch="Uniform" Width="{DynamicResource MapDisplayWidth}">
                    <Grid Width="680" Height="480">
                        <Border Background="{DynamicResource ColorF0EEE7}" BorderBrush="{DynamicResource ColorD9D5C9}" BorderThickness="1" Margin="10,30" />
                        <Canvas>
                            <Rectangle Canvas.Left="38" Canvas.Top="210" Width="604" Height="50" Fill="{DynamicResource ColorFDFCF9}" />
                            <Rectangle Canvas.Left="103" Canvas.Top="168" Width="44" Height="166" Fill="{DynamicResource ColorFDFCF9}" />
                            <Rectangle Canvas.Left="318" Canvas.Top="168" Width="44" Height="166" Fill="{DynamicResource ColorFDFCF9}" />
                            <Rectangle Canvas.Left="533" Canvas.Top="168" Width="44" Height="166" Fill="{DynamicResource ColorFDFCF9}" />
                        </Canvas>
                        <ItemsControl ItemsSource="{Binding Map.Places}" ItemsPanel="{StaticResource MapPanel}"
                                      ItemContainerStyle="{StaticResource MapPosition}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="{Binding Width}" Height="{Binding Height}" Style="{StaticResource PlaceButton}"
                                            Command="{Binding DataContext.SelectPlaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{local:Translate Path=Name}">
                                        <TextBlock Text="{local:Translate Path=Name}" TextWrapping="Wrap" TextAlignment="Center" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding VisibleRouteSteps}" ItemsPanel="{StaticResource MapPanel}" IsHitTestVisible="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Line X1="{Binding From.X}" Y1="{Binding From.Y}" X2="{Binding To.X}" Y2="{Binding To.Y}"
                                          Stroke="{DynamicResource Color337F76}" StrokeThickness="{DynamicResource RouteThickness}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding DestinationMarkers}" ItemsPanel="{StaticResource MapPanel}"
                                      ItemContainerStyle="{StaticResource MapPosition}" IsHitTestVisible="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="14" Height="14" Fill="{DynamicResource Color337F76}" Stroke="{DynamicResource ColorFDFCF9}" StrokeThickness="3">
                                        <Ellipse.RenderTransform><TranslateTransform X="-7" Y="-7" /></Ellipse.RenderTransform>
                                    </Ellipse>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Map.Markers}" ItemsPanel="{StaticResource MapPanel}"
                                      ItemContainerStyle="{StaticResource MapPosition}" IsHitTestVisible="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="200" MinHeight="30">
                                        <Grid.RenderTransform><TranslateTransform X="-100" Y="-15" /></Grid.RenderTransform>
                                        <Border HorizontalAlignment="Center" Padding="9,5" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource ColorFDFCF9}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ColorC4C0B3}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsKiosk}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ColorA74F42}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ColorA74F42}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{local:Translate Path=Label}" FontSize="{DynamicResource Font12}" TextWrapping="Wrap" TextAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Color64675C}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsKiosk}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Viewbox></ScrollViewer>
                <StackPanel Grid.Row="2"><TextBlock Text="{DynamicResource 확대된 지도는 스크롤하여 볼 수 있습니다.}" FontSize="{DynamicResource Font12}" TextWrapping="Wrap" Visibility="{Binding LowVision, Converter={StaticResource VisibleWhenTrue}}"/><TextBlock Text="{local:Translate Path=ErrorMessage}" Foreground="{DynamicResource ColorA74F42}" FontSize="{DynamicResource Font13}" TextWrapping="Wrap" /></StackPanel>
            </Grid>

            <Border Grid.Column="2" Background="{DynamicResource ColorWhite}" BorderBrush="{DynamicResource ColorD8D6CC}" BorderThickness="1,0,0,0" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                        <StackPanel>
                            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhenTrue}}">
                                <Border Background="{DynamicResource ColorA58653}" Height="3" Width="28" HorizontalAlignment="Left" Margin="0,5,0,18" />
                                <TextBlock Text="{local:Translate Path=SelectedPlace.Name}" FontSize="{DynamicResource Font26}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <Button Content="{DynamicResource 상세정보 보기}" Command="{Binding OpenDetailCommand}" Style="{StaticResource ActionButton}" Margin="0,12,0,0"/><TextBlock Text="{Binding SelectedPlace.FloorLabel}" Foreground="{DynamicResource Color73766B}" FontSize="{DynamicResource Font13}" TextWrapping="Wrap" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding SelectedPlace.Hours}" FontFamily="Segoe UI" Foreground="{DynamicResource Color73766B}" FontSize="{DynamicResource Font15}" Margin="0,8,0,0" />
                                <Button Command="{Binding FindRouteCommand}" Style="{StaticResource ActionButton}"
                                        Background="{DynamicResource Color282E27}" Foreground="White" BorderBrush="{DynamicResource Color282E27}" Margin="0,24,0,0" FontSize="{DynamicResource Font16}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource 길찾기}" />
                                        <TextBlock Text="→" FontFamily="Segoe UI" Margin="28,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Visibility="{Binding HasRoute, Converter={StaticResource VisibleWhenTrue}}" Margin="0,28,0,0">
                                <TextBlock Text="{Binding RouteSummary}" FontFamily="Segoe UI" FontSize="{DynamicResource Font20}" Foreground="{DynamicResource Color337F76}" Margin="0,0,0,16" />
                                <ItemsControl ItemsSource="{Binding RouteInstructions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource ColorD9E5DE}" BorderThickness="2,0,0,0" Padding="12,0,0,0" Margin="0,0,0,18">
                                                <TextBlock Text="{Binding}" FontSize="{DynamicResource Font13}" TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="{DynamicResource 경로 지우기}" Command="{Binding ClearRouteCommand}" Style="{StaticResource ActionButton}"
                                        BorderThickness="0" HorizontalAlignment="Left" Padding="0,6" Foreground="{DynamicResource Color73766B}" FontSize="{DynamicResource Font12}" />
                            </StackPanel>
                        </StackPanel>

                    <StackPanel>

                        <Border Height="1" Background="{DynamicResource ColorD8D6CC}" Margin="0,20,0,18" />
                        <TextBlock Text="{DynamicResource 편의시설}" FontSize="{DynamicResource Font12}" Foreground="{DynamicResource Color898C81}" Margin="0,0,0,8" />
                        <Button Content="{DynamicResource 화장실}" Command="{Binding FindFacilityCommand}" CommandParameter="화장실"
                                Style="{StaticResource FacilityButton}" />
                        <Button Content="{DynamicResource 수유실}" Command="{Binding FindFacilityCommand}" CommandParameter="수유실"
                                Style="{StaticResource FacilityButton}" />
                        <Button Content="{DynamicResource 고객센터}" Command="{Binding FindFacilityCommand}" CommandParameter="고객센터"
                                Style="{StaticResource FacilityButton}" />
                        <Button Content="{DynamicResource 주차장 연결 통로}" Command="{Binding FindFacilityCommand}" CommandParameter="주차장 연결 통로"
                                Style="{StaticResource FacilityButton}" BorderThickness="0" />
                    </StackPanel>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource ColorWhite}" Padding="32"
                Visibility="{Binding IsDetailOpen, Converter={StaticResource VisibleWhenTrue}}"
                KeyboardNavigation.TabNavigation="Cycle">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">
                    <Button x:Name="DetailBackButton" Content="{DynamicResource 뒤로가기}" Command="{Binding CloseDetailCommand}"
                            Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,0,0,24"/>
                    <TextBlock Text="{DynamicResource 매장 상세정보}" FontSize="{DynamicResource Font17}" Foreground="{DynamicResource Color73766B}"/>
                    <TextBlock Text="{local:Translate Path=SelectedPlace.Name}" FontSize="{DynamicResource Font32}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,24"/>
                    <TextBlock Text="{DynamicResource 카테고리}" FontSize="{DynamicResource Font15}" Foreground="{DynamicResource Color73766B}"/>
                    <TextBlock Text="{local:Translate Path=SelectedPlace.Category}" FontSize="{DynamicResource Font22}" TextWrapping="Wrap" Margin="0,6,0,20"/>
                    <TextBlock Text="{DynamicResource 위치}" FontSize="{DynamicResource Font15}" Foreground="{DynamicResource Color73766B}"/>
                    <TextBlock Text="{Binding SelectedPlace.FloorLabel}" FontSize="{DynamicResource Font22}" TextWrapping="Wrap" Margin="0,6,0,20"/>
                    <TextBlock Text="{DynamicResource 영업시간}" FontSize="{DynamicResource Font15}" Foreground="{DynamicResource Color73766B}"/>
                    <TextBlock Text="{Binding SelectedPlace.Hours}" FontSize="{DynamicResource Font22}" Margin="0,6,0,24"/>
                    <TextBlock Text="{DynamicResource 길찾기를 누르면 현재 키오스크에서 선택한 장소 입구까지 안내합니다.}" FontSize="{DynamicResource Font17}" TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <TextBlock Text="{local:Translate Path=ErrorMessage}" Foreground="{DynamicResource ColorA74F42}" FontSize="{DynamicResource Font17}" TextWrapping="Wrap"/>
                    <Button Content="{DynamicResource 길찾기}" Command="{Binding FindRouteCommand}" Style="{StaticResource ActionButton}"
                            Background="{DynamicResource Color282E27}" Foreground="White" FontSize="{DynamicResource Font22}" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
