<Window x:Class="MallWay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding MallName}" Width="1360" Height="820" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" FontFamily="Malgun Gothic"
        Background="#F6F5F1" Foreground="#262823"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <Style TargetType="ScrollViewer">
            <Setter Property="PanningMode" Value="VerticalOnly" />
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C7C6BC" CornerRadius="2" Margin="3,0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ItemsPanelTemplate x:Key="MapPanel"><Canvas /></ItemsPanelTemplate>
        <Style x:Key="MapPosition" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#262823" />
            <Setter Property="BorderBrush" Value="#D5D4CB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#967343" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResultButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,17" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#EDE6D6" />
                    <Setter Property="BorderBrush" Value="#AA8651" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FacilityButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,17" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="PlaceButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#E6E3D9" />
            <Setter Property="BorderBrush" Value="#CCC8BB" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FontSize" Value="17" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#E9D9B4" />
                    <Setter Property="BorderBrush" Value="#8C6D3C" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FloorTab" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="18" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="BorderBrush" Value="#262823" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CategoryItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Surface" Background="White" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#F0EDE4" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#EDE6D6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CategorySelect" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource CategoryItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="White" BorderBrush="#D5D4CB" BorderThickness="0,0,0,1">
                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#73766B" StrokeThickness="1"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="10,0,32,0"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center" IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                                <Border Background="White" BorderBrush="#D5D4CB" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="280"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#D8D6CC" BorderThickness="0,0,0,1" Padding="28,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="24" Height="25" Margin="0,0,13,0">
                    <Path Data="M 1 24 L 1 7 L 8 7 L 8 24 M 8 24 L 8 1 L 16 1 L 16 24 M 16 24 L 16 10 L 23 10 L 23 24"
                          Stroke="#9D7A46" StrokeThickness="1.5" />
                </Grid>
                <TextBlock Text="{Binding MallName}" FontSize="21" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="252" />
            </Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="#D8D6CC" BorderThickness="0,0,1,0" Padding="22,24,22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Border Background="#F5F4EF" BorderBrush="#BEBEB2" BorderThickness="0,0,0,1" Height="48">
                            <Grid>
                                <Path Data="M 14 9 A 5 5 0 1 1 4 9 A 5 5 0 1 1 14 9 M 13 13 L 18 18"
                                      Stroke="#55594F" StrokeThickness="1.5" Width="22" Height="22"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" FontSize="15"
                                         Margin="38,0,8,0" VerticalContentAlignment="Center"
                                         AutomationProperties.Name="매장 검색" />
                                <TextBlock Text="매장 검색" Foreground="#777B70" FontSize="15"
                                           Margin="40,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                  Style="{StaticResource CategorySelect}" Margin="0,12,0,0"
                                  AutomationProperties.Name="카테고리 선택" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,16,0,4">
                        <TextBlock Text="{Binding ResultsSummary}" Foreground="#777B70" FontSize="12" VerticalAlignment="Center" />
                        <Button Content="초기화" Command="{Binding ResetSearchCommand}" HorizontalAlignment="Right"
                                Style="{StaticResource ActionButton}" BorderThickness="0" Padding="10,6"
                                Foreground="#777B70" FontSize="12" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ResultButton}"
                                                Command="{Binding DataContext.SelectPlaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="15" TextWrapping="Wrap" Margin="0,0,6,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Floor, StringFormat={}{0}F}"
                                                           Foreground="#777B70" FontFamily="Segoe UI" FontSize="13"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="검색 결과 없음" Foreground="#777B70" FontSize="14" Margin="10,20,0,0"
                                   Visibility="{Binding HasNoResults, Converter={StaticResource VisibleWhenTrue}}" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="28,20,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding CurrentFloor, StringFormat={}{0}F}" FontFamily="Segoe UI"
                                   FontSize="58" FontWeight="Light" LineHeight="64" />
                        <TextBlock Text="{Binding Map.Name}" FontSize="19" Margin="14,0,0,11" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Floors}" SelectedValuePath="Number"
                             SelectedValue="{Binding CurrentFloor, Mode=OneWay}"
                             BorderThickness="0" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Number}" ContentStringFormat="{}{0}F" Style="{StaticResource FloorTab}"
                                        Command="{Binding DataContext.ChangeFloorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Viewbox Grid.Row="1" Stretch="Uniform">
                    <Grid Width="680" Height="480">
                        <Border Background="#F0EEE7" BorderBrush="#D9D5C9" BorderThickness="1" Margin="10,30" />
                        <Canvas>
                            <Rectangle Canvas.Left="38" Canvas.Top="210" Width="604" Height="50" Fill="#FDFCF9" />
                            <Rectangle Canvas.Left="103" Canvas.Top="168" Width="44" Height="166" Fill="#FDFCF9" />
                            <Rectangle Canvas.Left="318" Canvas.Top="168" Width="44" Height="166" Fill="#FDFCF9" />
                            <Rectangle Canvas.Left="533" Canvas.Top="168" Width="44" Height="166" Fill="#FDFCF9" />
                        </Canvas>
                        <ItemsControl ItemsSource="{Binding Map.Places}" ItemsPanel="{StaticResource MapPanel}"
                                      ItemContainerStyle="{StaticResource MapPosition}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="{Binding Width}" Height="{Binding Height}" Style="{StaticResource PlaceButton}"
                                            Command="{Binding DataContext.SelectPlaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding VisibleRouteSteps}" ItemsPanel="{StaticResource MapPanel}" IsHitTestVisible="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Line X1="{Binding From.X}" Y1="{Binding From.Y}" X2="{Binding To.X}" Y2="{Binding To.Y}"
                                          Stroke="#337F76" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding DestinationMarkers}" ItemsPanel="{StaticResource MapPanel}"
                                      ItemContainerStyle="{StaticResource MapPosition}" IsHitTestVisible="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="14" Height="14" Fill="#337F76" Stroke="#FDFCF9" StrokeThickness="3">
                                        <Ellipse.RenderTransform><TranslateTransform X="-7" Y="-7" /></Ellipse.RenderTransform>
                                    </Ellipse>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Map.Markers}" ItemsPanel="{StaticResource MapPanel}"
                                      ItemContainerStyle="{StaticResource MapPosition}" IsHitTestVisible="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="154" Height="30">
                                        <Grid.RenderTransform><TranslateTransform X="-77" Y="-15" /></Grid.RenderTransform>
                                        <Border HorizontalAlignment="Center" Padding="9,5" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FDFCF9" />
                                                    <Setter Property="BorderBrush" Value="#C4C0B3" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsKiosk}" Value="True">
                                                            <Setter Property="Background" Value="#A74F42" />
                                                            <Setter Property="BorderBrush" Value="#A74F42" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Label}" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64675C" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsKiosk}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Viewbox>
                <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="#A74F42" FontSize="13" TextWrapping="Wrap" />
            </Grid>

            <Border Grid.Column="2" Background="White" BorderBrush="#D8D6CC" BorderThickness="1,0,0,0" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhenTrue}}">
                                <Border Background="#A58653" Height="3" Width="28" HorizontalAlignment="Left" Margin="0,5,0,18" />
                                <TextBlock Text="{Binding SelectedPlace.Name}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedPlace.FloorLabel}" Foreground="#73766B" FontSize="13" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding SelectedPlace.Hours}" FontFamily="Segoe UI" Foreground="#73766B" FontSize="15" Margin="0,8,0,0" />
                                <Button Command="{Binding FindRouteCommand}" Style="{StaticResource ActionButton}"
                                        Background="#282E27" Foreground="White" BorderBrush="#282E27" Margin="0,24,0,0" FontSize="16">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="길찾기" />
                                        <TextBlock Text="→" FontFamily="Segoe UI" Margin="28,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Visibility="{Binding HasRoute, Converter={StaticResource VisibleWhenTrue}}" Margin="0,28,0,0">
                                <TextBlock Text="{Binding RouteSummary}" FontFamily="Segoe UI" FontSize="20" Foreground="#337F76" Margin="0,0,0,16" />
                                <ItemsControl ItemsSource="{Binding RouteInstructions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#D9E5DE" BorderThickness="2,0,0,0" Padding="12,0,0,0" Margin="0,0,0,18">
                                                <TextBlock Text="{Binding}" FontSize="13" LineHeight="21" TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="경로 지우기" Command="{Binding ClearRouteCommand}" Style="{StaticResource ActionButton}"
                                        BorderThickness="0" HorizontalAlignment="Left" Padding="0,6" Foreground="#73766B" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Grid.Row" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                        <Setter Property="Grid.Row" Value="0" />
                                        <Setter Property="VerticalAlignment" Value="Top" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Height="1" Background="#D8D6CC" Margin="0,20,0,18" />
                        <TextBlock Text="편의시설" FontSize="12" Foreground="#898C81" Margin="0,0,0,8" />
                        <Button Content="화장실" Command="{Binding FindFacilityCommand}" CommandParameter="화장실"
                                Style="{StaticResource FacilityButton}" />
                        <Button Content="수유실" Command="{Binding FindFacilityCommand}" CommandParameter="수유실"
                                Style="{StaticResource FacilityButton}" />
                        <Button Content="고객센터" Command="{Binding FindFacilityCommand}" CommandParameter="고객센터"
                                Style="{StaticResource FacilityButton}" />
                        <Button Content="주차장 연결 통로" Command="{Binding FindFacilityCommand}" CommandParameter="주차장 연결 통로"
                                Style="{StaticResource FacilityButton}" BorderThickness="0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
